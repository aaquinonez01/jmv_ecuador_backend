# Puerto en el que escucha la API NestJS
PORT=3002

# Postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=jmv

# JWT
JWT_SECRET=changeme

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL interna del frontend Next.js para invalidar el cache ISR cuando admin
# edita contenido público. Debe apuntar al frontend por la red interna del entorno.
# - En docker-compose: http://frontend:3000
# - Mismo host VPS:    http://127.0.0.1:3000
FRONTEND_URL=http://frontend:3000

# Token compartido con el frontend (header x-revalidate-token).
# Mismo valor que REVALIDATE_TOKEN en el .env del frontend.
REVALIDATE_TOKEN=changeme-random-string-min-32-chars

# Solo para el PRIMER arranque con la base vacía: crea las tablas.
# Después de que el backend arranque bien, volver a false (o borrar la línea).
DB_SYNCHRONIZE=false

# Administrador inicial: se crea al arrancar si aún no existe ningún admin.
# Usa una contraseña fuerte (mín. 10 caracteres). Tras el primer arranque
# puedes borrar estas dos líneas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL pública del sitio: se usa para el enlace de "Restablecer contraseña"
# que llega por correo (${PUBLIC_SITE_URL}/reset-password?token=...).
PUBLIC_SITE_URL=https://jmvecuador.org

# Correo saliente (SMTP). Opcional: si SMTP_HOST está vacío no se envían
# correos (solo se registra un aviso en el log); los mensajes de contacto se
# guardan igual y se pueden leer desde el panel de administración.
# - SMTP_PORT 587 con SMTP_SECURE=false (STARTTLS) o 465 con SMTP_SECURE=true
# - Con Gmail/Google Workspace, SMTP_PASS es una "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que verán las personas, p. ej. "JMV Ecuador <no-reply@jmvecuador.org>"
MAIL_FROM=
# Correo (o lista separada por comas) que recibe los avisos del formulario de contacto
CONTACT_NOTIFY_TO=

# Clave compartida con el frontend (mismo valor que INTERNAL_PROXY_KEY en su .env).
# Con ella, Next indica la IP real del visitante (X-Client-IP) para el límite de
# envíos del formulario de contacto. Sin ella solo se confía en CF-Connecting-IP
# cuando la petición llega desde los rangos de IP de Cloudflare.
INTERNAL_PROXY_KEY=

# Biblioteca JMV: carpeta donde se guardan los PDF subidos desde el admin.
# Por defecto <carpeta del backend>/uploads/library. En docker-compose apunta
# al volumen "library_files" (/app/uploads/library): no lo cambies ahí.
# LIBRARY_STORAGE_DIR=/app/uploads/library

# URL pública de esta API (con /api al final). Se usa para armar el enlace
# "fileUrl" de los PDF que verá el navegador. Por defecto
# https://api.jmvecuador.org/api; en desarrollo, si está vacía, se toma del
# host de la petición.
# PUBLIC_API_URL=https://api.jmvecuador.org/api
